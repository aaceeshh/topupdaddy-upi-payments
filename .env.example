# Generate a long random token; use it only from your trusted backend.
ADMIN_API_TOKEN=
PAYEE_VPA=
PAYEE_NAME=TopUpDaddy
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DB_PATH=./data/payments.sqlite
# Checkout access expires independently from the 24-hour payment window (60-3600 seconds).
CHECKOUT_TOKEN_TTL_SECONDS=1800
# Empty ignores forwarded headers. List ONLY the IPs/CIDRs of your actual reverse proxies.
TRUSTED_PROXY_CIDRS=
# Copy the Transactions URL from the same Google Pay merchant dashboard.
GPAY_TRANSACTIONS_URL=
GPAY_PROFILE_DIR=./profiles/gpay
GPAY_HEADLESS=true
GPAY_CHANNEL=chrome
GPAY_POLL_SECONDS=60
GPAY_MAX_PAGES=10
# Dashboard timestamps were observed in English/India format. Verify timezone.
GPAY_TIMEZONE=Asia/Kolkata
