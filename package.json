{
  "name": "topupdaddy-upi-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "login": "node --env-file-if-exists=.env src/worker.js --login",
    "test": "node --test test/payment.test.js test/store.test.js test/api.test.js test/security.test.js",
    "test:browser": "node --test test/browser.test.js",
    "check": "node --check src/server.js && node --check src/worker.js"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "playwright": "^1.56.0",
    "proxy-addr": "2.0.8",
    "rate-limiter-flexible": "11.2.1",
    "upiqr": "1.4.1"
  }
}
